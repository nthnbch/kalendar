<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_preview_background"
    android:orientation="vertical" android:padding="12dp" tools:ignore="HardcodedText">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="@string/today" android:textColor="#FF0A5FD8" android:textSize="13sp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="12" android:textColor="#FF1A1C1E" android:textSize="22sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="44dp" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="THU" android:textColor="#FF5A5F66" android:textSize="10sp" />
            <TextView android:layout_width="28dp" android:layout_height="28dp" android:gravity="center" android:text="12" android:textSize="15sp" android:textStyle="bold" android:background="@drawable/widget_preview_today" android:textColor="#FFFFFFFF" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/widget_preview_chip_blue" android:orientation="vertical" android:paddingHorizontal="12dp" android:paddingVertical="7dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="Stand-up" android:textColor="#FF1A1C1E" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="09:00 – 09:30" android:textColor="#FF5A5F66" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="44dp" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FF5A5F66" android:textSize="10sp" />
            <TextView android:layout_width="28dp" android:layout_height="28dp" android:gravity="center" android:text="" android:textSize="15sp" android:textStyle="bold" android:textColor="#FF1A1C1E" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/widget_preview_chip_pink" android:orientation="vertical" android:paddingHorizontal="12dp" android:paddingVertical="7dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="Lunch" android:textColor="#FF1A1C1E" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="12:15 – 13:30" android:textColor="#FF5A5F66" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="44dp" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FRI" android:textColor="#FF5A5F66" android:textSize="10sp" />
            <TextView android:layout_width="28dp" android:layout_height="28dp" android:gravity="center" android:text="13" android:textSize="15sp" android:textStyle="bold" android:textColor="#FF1A1C1E" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/widget_preview_chip_blue" android:orientation="vertical" android:paddingHorizontal="12dp" android:paddingVertical="7dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="Train · Lausanne" android:textColor="#FF1A1C1E" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="07:42 – 08:20" android:textColor="#FF5A5F66" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
